# Docker Hub 镜像。发布后默认使用 lvyunqi/qimenbot:latest。
QIMENBOT_IMAGE=lvyunqi/qimenbot
QIMENBOT_TAG=latest

# 管理面板 Bearer Token，必须修改为随机长字符串。
QIMEN_ADMIN_TOKEN=replace-with-a-long-random-token

# QQ 官方机器人凭据，不要提交真实值。
QQBOT_APPID=replace-with-your-appid
QQBOT_SECRET=replace-with-your-secret

# 只有启用 Webhook 时才需要。
QIMEN_WEBHOOK_TOKEN=
