# Docker Hub 镜像。生产环境建议把 Tag 固定到具体版本。
QIMENBOT_IMAGE=mryunqi/qimenbot
QIMENBOT_TAG=latest

# 宿主机持久化目录。可以改成数据盘上的绝对路径。
QIMEN_CONFIG_DIR=./data/config
QIMEN_PLUGIN_DIR=./data/plugins
QIMEN_LOG_DIR=./data/logs

# 管理面板 Bearer Token，必须修改为随机长字符串。
QIMEN_ADMIN_TOKEN=

# QQ 官方机器人凭据。使用 OneBot 时可以留空。
QQBOT_APPID=
QQBOT_SECRET=

# 只有启用 Webhook 时才需要。
QIMEN_WEBHOOK_TOKEN=

# 日志过滤级别：trace / debug / info / warn / error。
RUST_LOG=info
