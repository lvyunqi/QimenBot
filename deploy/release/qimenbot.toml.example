[process]
# qimenbot 是用户入口，核心程序固定放在 runtime/ 目录。
binary = "runtime/qimenbotd"
working_dir = "."
args = []
restart_policy = "on-failure"
restart_delay_secs = 3
max_crash_restarts = 5
graceful_shutdown_secs = 30
startup_grace_secs = 3

# 管理面板关闭时可设为空字符串，此时只检查核心进程是否持续运行。
health_url = "http://127.0.0.1:3210/healthz"
health_timeout_secs = 45

[update]
enabled = true
repository = "lvyunqi/QimenBot"
channel = "stable"

# 可选的 HTTPS 下载代理。需支持在地址后拼接完整 GitHub URL。
# 留空时直连 GitHub。代理会提供 Release 列表、制品和 SHA256 校验文件，请使用可信服务。
# github_proxy = "https://gh-proxy.com/"

# 默认只提示新版本，由用户在面板确认；确认稳定后可改为 true。
auto_install = false
check_interval_secs = 21600
request_timeout_secs = 30
update_dir = ".qimen-update"
